{
  "manifest_version": 3,
  "name": "Attention",
  "version": "0.27.0",
  "minimum_chrome_version": "116",
  "description": "Decide what to read, skim, save or skip based on your personal profile and goals. Jump to passages that may be new to you.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_permissions": ["history"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' https://ai-gateway.vercel.sh https://readwise.io https://api.notion.com; object-src 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Evaluate this page",
    "default_popup": "popup.html"
  }
}
