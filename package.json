{
  "name": "page-capture-extension",
  "version": "0.21.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:real": "node scripts/check-real-materials.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preview": "node scripts/preview-server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:e2e": "pnpm build && pnpm test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.26",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.77"
  }
}
